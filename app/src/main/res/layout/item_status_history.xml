<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Timeline dot and vertical line -->
    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_status_dot"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:background="#CCCCCC"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_history_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN_PROGRESS"
                android:textColor="@color/primary_dark"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_history_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="May 20, 2025 at 10:30 AM"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tv_history_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status updated by Facilities Admin."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tv_history_author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Updated by: Facilities Admin"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
