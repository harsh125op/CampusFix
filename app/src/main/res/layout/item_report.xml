<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: Report ID & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_item_report_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CF-20250520-001"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_item_priority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tv_item_report_id"
                android:layout_marginStart="8dp"
                android:text="HIGH"
                android:textColor="@color/priority_high"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#FFF3E0"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp" />

            <TextView
                android:id="@+id/tv_item_demo_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/tv_item_priority"
                android:layout_marginStart="6dp"
                android:text="DEMO"
                android:textColor="#E65100"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="#FFE0B2"
                android:paddingHorizontal="4dp"
                android:paddingVertical="2dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_item_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="IN_PROGRESS"
                android:textColor="@color/status_in_progress"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="#E1F5FE"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp" />

        </RelativeLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_item_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Issue Title Placeholder"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_marginBottom="4dp" />

        <!-- Category & Location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_item_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electrical"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="italic" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_item_location"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Library 2nd Floor"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Bottom row: Date -->
        <TextView
            android:id="@+id/tv_item_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 20, 2025"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
