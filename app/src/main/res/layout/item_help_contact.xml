<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_contact_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Campus Security &amp; Safety"
            android:textColor="@color/primary_dark"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginBottom="2dp" />

        <TextView
            android:id="@+id/tv_contact_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Emergency Response Dispatch"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="italic"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_contact_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Building A, Ground Floor"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_contact_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="24/7 Campus safety, medical emergency dispatch, and escort service."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share_contact"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share Info"
                android:textSize="12sp"
                app:icon="@drawable/ic_info"
                android:layout_marginEnd="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_call_contact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Call Now"
                android:textSize="12sp"
                app:icon="@drawable/ic_phone"
                android:backgroundTint="@color/primary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
